{
    "name": "nitida/wp-svg",
    "description": "WordPress plugin: allows SVG uploads and sanitizes every one with enshrined/svg-sanitize, so an uploaded SVG cannot run script. Activate per site.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "homepage": "https://github.com/lintmycode/wp-svg",
    "authors": [
        {
            "name": "nitida",
            "homepage": "https://nitida.pt"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-dom": "*",
        "composer/installers": "^1.0 || ^2.0",
        "enshrined/svg-sanitize": "^0.22 || ^1.0"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
